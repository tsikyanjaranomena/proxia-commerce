# Copiez ce fichier vers .env puis adaptez les valeurs.

# Base de données. SQLite en local ; pour PostgreSQL en production :
#   1. dans prisma/schema.prisma, remplacez provider = "sqlite" par "postgresql"
#   2. DATABASE_URL="postgresql://user:motdepasse@hote:5432/madaexpress"
DATABASE_URL="file:./dev.db"

# Secret de signature des jetons de session (chaîne aléatoire longue, à garder privée).
JWT_SECRET="changez-moi"

PORT=4000

# Origines autorisées à appeler l'API (séparées par des virgules).
CORS_ORIGIN="http://localhost:5173"

# Mode démo : le code SMS est renvoyé dans la réponse, le client peut valider
# lui-même la remise avec son PIN, et les livreurs sont simulés.
# À mettre à false en production.
DEMO_MODE=true

# Fournisseur de paiement Mobile Money : "simulator" tant que vous n'avez pas
# de contrat marchand (voir src/services/payments/).
PAYMENT_PROVIDER=simulator

OSRM_URL="https://router.project-osrm.org/route/v1/driving"
