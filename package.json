{
  "name": "madaexpress",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm --prefix server run dev\" \"vite --host\"",
    "build": "vite build",
    "preview": "vite preview --host",
    "lint": "eslint .",
    "dev:web": "vite --host",
    "dev:api": "npm --prefix server run dev",
    "setup": "npm install && npm --prefix server install && npm --prefix server run db:setup",
    "start": "npm --prefix server start"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "lucide-react": "^0.511.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "socket.io-client": "^4.8.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tailwindcss/vite": "^4.1.8",
    "@vitejs/plugin-react": "^4.5.0",
    "concurrently": "^10.0.7",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^17.14.0",
    "tailwindcss": "^4.1.8",
    "vite": "^6.3.5"
  }
}
